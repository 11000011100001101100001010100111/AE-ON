import sys
import os
import time
import threading
import readline
import atexit
from datetime import datetime

# IMPORT TOMES
from core import system
from meteor import station

class NexusShell:
    def __init__(self):
        self.active = True
        self.lock = threading.Lock()
        
        # Colors
        self.RED = "\033[31m"
        self.SILVER = "\033[90m"
        self.BRASS = "\033[33m"
        self.RESET = "\033[0m"
        self.CRIMSON = "\033[91m"
        
        # Initialize
        self.sys_core = system.AeonLattice()
        self.wx_station = station.WeatherStation()
        
        # History
        self.hist_file = os.path.join(os.path.expanduser("~"), ".nexus_history")
        try:
            readline.read_history_file(self.hist_file)
            readline.set_history_length(100)
        except FileNotFoundError: pass
        atexit.register(readline.write_history_file, self.hist_file)

    def get_cursor_pos(self):
        sys.stdout.write("\033[s") 

    def restore_cursor_pos(self):
        sys.stdout.write("\033[u")
        sys.stdout.flush()

    def render_header(self):
        while self.active:
            with self.lock:
                self.get_cursor_pos()
                sys.stdout.write("\033[H")
                
                now = datetime.now()
                cycle = f"Zn[30].{now.strftime('%j')}.{now.strftime('%H%M')}"
                pulse = f"{(int(time.time()) % 100) / 100:.2f}" 
                
                batt = 100 
                if batt <= 21: batt_str = f"{self.BRASS}WARN:21%{self.RED}"
                else: batt_str = "BAT:ON"

                header = (
                    f"{self.RED}┌──[ {self.CRIMSON}Æ-ON LATTICE{self.RED} ]──"
                    f"─[ {self.SILVER}{cycle}{self.RED} ]──"
                    f"─[ {self.BRASS}φ {pulse}{self.RED} ]──"
                    f"─[ {self.SILVER}{batt_str}{self.RED} ]──┐{self.RESET}"
                )
                
                sys.stdout.write("\033[2K")
                sys.stdout.write(header + "\n")
                self.restore_cursor_pos()
            time.sleep(1)

    def ignite(self):
        os.system('cls' if os.name == 'nt' else 'clear')
        threading.Thread(target=self.render_header, daemon=True).start()
        
        print("\n" * 2)
        print(f"{self.SILVER}System Online. The Hawk has landed.{self.RESET}")
        
        while self.active:
            try:
                cmd = input(f"{self.RED}>> {self.RESET}").strip().lower()
                
                with self.lock:
                    if cmd in ["exit", "salud"]:
                        self.active = False
                        return
                        
                    elif cmd == "sys":
                        print(f"\n{self.SILVER}>> KERNEL: OPTIMAL{self.RESET}")
                        print(f"{self.SILVER}>> CORE:   {self.sys_core.__class__.__name__}{self.RESET}")
                    
                    elif cmd in ["meteor", "metar", "slap"]:
                        print(f"\n{self.BRASS}>> SCANNING ATMOSPHERE...{self.RESET}")
                        data = self.wx_station.slap_data()
                        sys.stdout.write("\033[1A\033[2K") 
                        print(f"{self.SILVER}>> {data}{self.RESET}")
                    
                    # [FIX] Added Help Command
                    elif cmd == "help":
                        print(f"\n{self.SILVER}cmds: sys, meteor, salud{self.RESET}")
                        
                    elif cmd:
                        print(f"\n{self.RED}[!] UNKNOWN: {cmd}{self.RESET}")
            except KeyboardInterrupt:
                self.active = False
                break
