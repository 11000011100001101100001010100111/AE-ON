import sys, os, time, curses, io, re
from datetime import datetime
from contextlib import redirect_stdout
from core import system, gitter, power, birdsong, refract
from meteor import station
from nexus import cart_loader, man

class NexusShell:
    def __init__(self):
        self.active = True
        self.chronicle = []
        self.max_history = 500
        self.slip_offset = 0
        self.input_buffer = ""
        self.dirty_deck = True
        
        # SYSTEMS
        self.sys_core = system.AeonLattice()
        self.wx_station = station.WeatherStation()
        self.diplomat = gitter.Diplomat()
        self.pwr_core = power.PowerCore()
        self.refractor = refract.GemRefract()
        self.cart_loader = cart_loader.CartridgeLoader()
        self.cartridges = self.cart_loader.scan_and_load()
        
        try: self.birdsong = birdsong.Birdsong(); self.crypto_active = True
        except: self.crypto_active = False

        self.ansi_escape = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')

    def strip_ansi(self, text):
        return self.ansi_escape.sub('', text)

    def log(self, text, force_draw=False):
        clean_text = self.strip_ansi(str(text))
        clean_text = clean_text.replace('\t', '  ')
        for line in clean_text.split('\n'):
            self.chronicle.append(line)
        if len(self.chronicle) > self.max_history:
            self.chronicle = self.chronicle[-self.max_history:]
        self.dirty_deck = True
        
        if force_draw and hasattr(self, 'stdscr'):
            rows, cols = self.stdscr.getmaxyx()
            self.draw_deck(self.stdscr, rows, cols)
            self.stdscr.refresh()

    def get_modulated_view(self, height):
        total = len(self.chronicle)
        end = total - self.slip_offset
        start = max(0, end - height)
        return self.chronicle[start:end], start

    def draw_header(self, stdscr, cols):
        now = datetime.now()
        cycle_delta = (time.time() % (42.34 * 60)) / 60.0
        delta_str = f"φ {cycle_delta:05.2f}"
        zn_cycle = f"Zn[30].{now.strftime('%j')}.{now.strftime('%H%M')}"
        lvl, st = self.pwr_core.get_status_string()
        
        try:
            C_RED = curses.color_pair(1)
            C_BRASS = curses.color_pair(2) | curses.A_BOLD
            C_SILVER = curses.color_pair(3)
            C_CYAN = curses.color_pair(4)
            cart_str = f"C:{len(self.cartridges)}"

            stdscr.move(0, 0); stdscr.clrtoeol()
            stdscr.addstr("┌──[ ", C_RED); stdscr.addstr("Æ-ON", C_SILVER); stdscr.addstr(" ]", C_RED)
            stdscr.addstr("──[ ", C_RED); stdscr.addstr(zn_cycle, C_BRASS); stdscr.addstr(" ]", C_RED)
            stdscr.addstr("──[ ", C_RED); stdscr.addstr(delta_str, C_BRASS); stdscr.addstr(" ]", C_RED)
            stdscr.addstr("──[ ", C_RED); stdscr.addstr(f"BAT:{lvl}%", C_RED if st == "CRITICAL" else C_SILVER); stdscr.addstr(" ]", C_RED)
            stdscr.addstr("──[ ", C_RED); stdscr.addstr(cart_str, C_CYAN); stdscr.addstr(" ]──┐", C_RED)
        except: pass

    def draw_deck(self, stdscr, rows, cols):
        stdscr.erase()
        self.draw_header(stdscr, cols)
        
        ft_line = "─" * (cols - 12)
        try:
            stdscr.addstr(rows-2, 0, f"└──[ ", curses.color_pair(1))
            stdscr.addstr("NEXUS", curses.color_pair(4))
            stdscr.addstr(f" ]{ft_line}┘", curses.color_pair(1))
        except: pass

        prompt_char = ">>" if self.slip_offset == 0 else "<<"
        try:
            stdscr.addstr(rows-1, 0, f"{prompt_char} ", curses.color_pair(1))
            stdscr.addstr(self.input_buffer, curses.color_pair(3))
        except: pass

        vp_height = rows - 5 
        view_data, start_idx = self.get_modulated_view(vp_height)
        start_row = 2
        for i, line in enumerate(view_data):
            if not line: continue
            
            abs_id = start_idx + i 
            id_tag = f"[{abs_id:03}]"
            color = curses.color_pair(3)
            if self.slip_offset == 0 and i == len(view_data)-1: color = curses.color_pair(2)
            
            try:
                max_text_len = max(10, cols - len(id_tag) - 4)
                clean_line = line[:max_text_len]
                stdscr.addstr(start_row + i, 1, id_tag, curses.color_pair(3))
                stdscr.addstr("│", curses.color_pair(1))
                stdscr.addstr(f" {clean_line}", color)
            except: pass

    def capture_tool_output(self, func, *args):
        f = io.StringIO()
        with redirect_stdout(f):
            try: func(*args)
            except Exception as e: print(f"ERR: {e}")
        self.log(f.getvalue())

    def handle_command(self, cmd_raw):
        # 1. SMART PARSING (Handle quotes or loose text)
        cmd_raw = cmd_raw.strip()
        if not cmd_raw: return
        
        parts = cmd_raw.split(" ")
        cmd = parts[0].lower()
        args = " ".join(parts[1:]) # Join rest of string (no quotes needed)
        
        self.log(f"> {cmd_raw.upper()}")

        if cmd in ["exit", "salud"]: self.active = False
        
        # SCROLLING
        elif cmd == "slip": self.slip_offset += int(parts[1]) if len(parts)>1 and parts[1].isdigit() else 10; self.dirty_deck = True
        elif cmd == "push": self.slip_offset = max(0, self.slip_offset - (int(parts[1]) if len(parts)>1 and parts[1].isdigit() else 10)); self.dirty_deck = True
        elif cmd == "live": self.slip_offset = 0; self.dirty_deck = True
        
        elif cmd == "sys":
            self.log(f"KERNEL: OPTIMAL | CORE: AeonLattice")
            self.log(f"CARTS:  {len(self.cartridges)}")
        
        # SMART SAVE (No "Clean" blocking, No quotes needed)
        elif cmd == "save":
            msg = args
            if not msg:
                # Fallback to Modal if no message provided
                self.log("[?] MSG REQUIRED. ENTERING MODAL...")
                self.dirty_deck = True; self.draw_deck(self.stdscr, *self.stdscr.getmaxyx()); self.stdscr.refresh()
                msg = self.get_curses_input("MSG:")
            
            if msg:
                # VISUAL FEEDBACK BEFORE BLOCKING
                self.log(f"[!] SYNCING LATTICE :: '{msg}'...", force_draw=True)
                
                # Execute
                try:
                    res = self.diplomat.execute_save(msg)
                    self.log(f"SYNC: {res}")
                except Exception as e:
                    self.log(f"SYNC ERR: {e}")
            else:
                self.log("ABORTED.")
        
        elif cmd == "meteor" or cmd == "slap":
            self.log(self.wx_station.slap_data())

        elif cmd == "refract": 
            self.capture_tool_output(self.refractor.generate_seed)
            
        elif cmd == "enc" and self.crypto_active: self.log(f"HASH: {self.birdsong.encrypt(args)}")
        elif cmd == "dec" and self.crypto_active: self.log(f"CLEAR: {self.birdsong.decrypt(args)}")

        elif cmd == "signal":
             self.refractor.write_signal("ARCHX", args); self.log("SENT.")

        elif cmd == "help":
             self.log("MANUALS INDEX:"); [self.log(f" - {c}") for c in self.cartridges]
             
        elif cmd in self.cartridges:
             self.log(f"LAUNCHING {cmd.upper()}...", force_draw=True)
             curses.endwin()
             try:
                 # Pass args as list if valid, else empty
                 c_args = parts[1:] if len(parts) > 1 else []
                 self.cartridges[cmd].run(c_args)
                 input("\n[PRESS ENTER]")
             except Exception as e: 
                 print(f"CRITICAL FAULT: {e}")
                 input("[ERR]")
             self.stdscr = curses.initscr()
             self.setup_colors()

    def get_curses_input(self, prompt_text):
        buffer = ""
        rows, cols = self.stdscr.getmaxyx()
        while True:
            try:
                stdscr = self.stdscr
                stdscr.attron(curses.color_pair(2))
                stdscr.move(rows-1, 0); stdscr.clrtoeol()
                stdscr.addstr(f"{prompt_text} {buffer}")
                stdscr.attroff(curses.color_pair(2))
                stdscr.refresh()
            except: pass
            try: key = stdscr.getch()
            except: key = -1
            if key == 10 or key == 13: return buffer
            elif key == 27: return None
            elif key == curses.KEY_BACKSPACE or key == 127: buffer = buffer[:-1]
            elif 32 <= key <= 126: buffer += chr(key)
            time.sleep(0.01)

    def setup_colors(self):
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_RED, -1)
        curses.init_pair(2, curses.COLOR_YELLOW, -1)
        curses.init_pair(3, curses.COLOR_WHITE, -1)
        curses.init_pair(4, curses.COLOR_CYAN, -1)

    def main_loop(self, stdscr):
        self.stdscr = stdscr
        self.setup_colors()
        curses.curs_set(1)
        stdscr.nodelay(True) 
        stdscr.timeout(10)
        self.log("System Online. Shell v2.2 (Edge).")
        last_hum_time = 0
        while self.active:
            rows, cols = stdscr.getmaxyx()
            if self.dirty_deck:
                self.draw_deck(stdscr, rows, cols)
                stdscr.refresh()
                self.dirty_deck = False
            elif time.time() - last_hum_time > 0.1:
                self.draw_header(stdscr, cols)
                try: stdscr.move(rows-1, len(self.input_buffer) + 3)
                except: pass
                stdscr.refresh()
                last_hum_time = time.time()
            try: key = stdscr.getch()
            except: key = -1
            if key != -1:
                self.dirty_deck = True
                if key == 10 or key == 13:
                    self.handle_command(self.input_buffer.strip())
                    self.input_buffer = ""
                elif key == 27: self.active = False
                elif key == curses.KEY_BACKSPACE or key == 127: self.input_buffer = self.input_buffer[:-1]
                elif 32 <= key <= 126: self.input_buffer += chr(key)

    def ignite(self):
        curses.wrapper(self.main_loop)

if __name__ == "__main__":
    shell = NexusShell()
    shell.ignite()
