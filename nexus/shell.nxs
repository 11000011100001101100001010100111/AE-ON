import sys
import os
import time
import threading
import readline
import atexit
from datetime import datetime

# IMPORT TOMES
from core import system
from core import gitter
from core import power
from core import birdsong  # [NEW]
from meteor import station

class NexusShell:
    def __init__(self):
        self.active = True
        self.lock = threading.Lock()
        
        # Colors
        self.RED = "\033[31m"
        self.SILVER = "\033[90m"
        self.BRASS = "\033[33m"
        self.RESET = "\033[0m"
        self.CRIMSON = "\033[91m"
        self.GREEN = "\033[32m"
        
        # Initialize
        self.sys_core = system.AeonLattice()
        self.wx_station = station.WeatherStation()
        self.diplomat = gitter.Diplomat()
        self.pwr_core = power.PowerCore()
        
        # [NEW] Initialize Birdsong (Crypto)
        try:
            self.birdsong = birdsong.Birdsong()
            self.crypto_active = True
        except ImportError:
            self.crypto_active = False
        
        # History
        self.hist_file = os.path.join(os.path.expanduser("~"), ".nexus_history")
        try:
            readline.read_history_file(self.hist_file)
            readline.set_history_length(100)
        except FileNotFoundError: pass
        atexit.register(readline.write_history_file, self.hist_file)

    def get_cursor_pos(self):
        sys.stdout.write("\033[s") 

    def restore_cursor_pos(self):
        sys.stdout.write("\033[u")
        sys.stdout.flush()

    def render_header(self):
        while self.active:
            with self.lock:
                self.get_cursor_pos()
                sys.stdout.write("\033[H")
                
                now = datetime.now()
                cycle = f"Zn[30].{now.strftime('%j')}.{now.strftime('%H%M')}"
                pulse = f"{(int(time.time()) % 100) / 100:.2f}" 
                
                level, status = self.pwr_core.get_status_string()
                
                if status == "CRITICAL":
                    batt_str = f"{self.BRASS}WARN:{level}%{self.RED}"
                else:
                    batt_str = f"BAT:{level}%"

                header = (
                    f"{self.RED}┌──[ {self.CRIMSON}Æ-ON LATTICE{self.RED} ]──"
                    f"─[ {self.SILVER}{cycle}{self.RED} ]──"
                    f"─[ {self.BRASS}φ {pulse}{self.RED} ]──"
                    f"─[ {self.SILVER}{batt_str}{self.RED} ]──┐{self.RESET}"
                )
                
                sys.stdout.write("\033[2K")
                sys.stdout.write(header + "\n")
                self.restore_cursor_pos()
            time.sleep(1)

    def ignite(self):
        # HARD CLEAR
        sys.stdout.write("\033[2J\033[3J\033[H")
        sys.stdout.flush()
        
        print("\n" * 2)
        print(f"{self.SILVER}System Online. The Hawk has landed.{self.RESET}")
        
        threading.Thread(target=self.render_header, daemon=True).start()
        
        while self.active:
            try:
                cmd = input(f"{self.RED}>> {self.RESET}").strip() # Case sensitive input for crypto
                cmd_lower = cmd.lower()
                
                with self.lock:
                    if cmd_lower in ["exit", "salud"]:
                        self.active = False
                        readline.write_history_file(self.hist_file)
                        return
                        
                    elif cmd_lower == "sys":
                        print(f"\n{self.SILVER}>> KERNEL: OPTIMAL{self.RESET}")
                        print(f"{self.SILVER}>> CORE:   {self.sys_core.__class__.__name__}{self.RESET}")
                        lvl, st = self.pwr_core.get_status_string()
                        print(f"{self.SILVER}>> POWER:  {lvl}% ({st}){self.RESET}")
                        # Check Crypto
                        c_status = "ACTIVE" if self.crypto_active else "MISSING LIB"
                        print(f"{self.SILVER}>> CRYPTO: {c_status}{self.RESET}")

                    # [NEW] Encryption Commands
                    elif cmd_lower.startswith("enc "):
                        if not self.crypto_active:
                            print(f"\n{self.RED}>> ERROR: Cryptography module missing.{self.RESET}")
                        else:
                            payload = cmd[4:] # Preserve case
                            token = self.birdsong.encrypt(payload)
                            print(f"\n{self.SILVER}>> HASH: {self.GREEN}{token}{self.RESET}")

                    elif cmd_lower.startswith("dec "):
                        if not self.crypto_active:
                            print(f"\n{self.RED}>> ERROR: Cryptography module missing.{self.RESET}")
                        else:
                            token = cmd[4:]
                            clear = self.birdsong.decrypt(token)
                            if "ERR:" in clear:
                                print(f"\n{self.RED}>> {clear}{self.RESET}")
                            else:
                                print(f"\n{self.SILVER}>> CLEAR: {self.BRASS}{clear}{self.RESET}")
                    
                    elif cmd_lower in ["meteor", "metar", "slap"]:
                        print(f"\n{self.BRASS}>> SCANNING ATMOSPHERE...{self.RESET}")
                        data = self.wx_station.slap_data()
                        sys.stdout.write("\033[1A\033[2K") 
                        print(f"{self.SILVER}>> {data}{self.RESET}")
                        
                    elif cmd_lower == "save":
                        changes = self.diplomat.get_status()
                        if not changes:
                            print(f"\n{self.SILVER}>> LATTICE CLEAN. NOTHING TO SAVE.{self.RESET}")
                        else:
                            print(f"\n{self.BRASS}>> CHANGES DETECTED:{self.RESET}")
                            for c in changes:
                                print(f"   {c}")

                    elif cmd_lower == "help":
                        print(f"\n{self.SILVER}cmds: sys, meteor, save, enc <txt>, dec <token>, salud{self.RESET}")
                        
                    elif cmd:
                        print(f"\n{self.RED}[!] UNKNOWN: {cmd}{self.RESET}")
                
                if cmd_lower == "save":
                    changes = self.diplomat.get_status()
                    if changes:
                        msg = input(f"{self.CRIMSON}>> COMMIT MSG: {self.RESET}").strip()
                        if msg:
                            print(f"{self.SILVER}>> NEGOTIATING WITH THE VOID...{self.RESET}")
                            result = self.diplomat.execute_save(msg)
                            if result == "SECURE":
                                print(f"{self.GREEN}>> SUCCESS. LATTICE SYNCED.{self.RESET}")
                            else:
                                print(f"{self.RED}>> ERROR: {result}{self.RESET}")

            except KeyboardInterrupt:
                self.active = False
                break
