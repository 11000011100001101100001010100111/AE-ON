import os
import base64

# [SAFEGUARD] Try to import, disable if missing
try:
    from cryptography.fernet import Fernet
    from cryptography.hazmat.primitives import hashes
    from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
    LIB_AVAILABLE = True
except ImportError:
    LIB_AVAILABLE = False
    Fernet = None

class Birdsong:
    def __init__(self):
        if not LIB_AVAILABLE:
            raise ImportError("Cryptography library not found.")
            
        self.key_file = os.path.join(os.path.expanduser("~"), ".aeon_key")
        self.key = self._load_or_create_key()
        self.cipher = Fernet(self.key)

    def _load_or_create_key(self):
        if os.path.exists(self.key_file):
            with open(self.key_file, "rb") as f:
                return f.read()
        else:
            key = Fernet.generate_key()
            with open(self.key_file, "wb") as f:
                f.write(key)
            return key

    def encrypt(self, raw_data):
        if not raw_data: return ""
        token = self.cipher.encrypt(raw_data.encode())
        return token.decode()

    def decrypt(self, token):
        if not token: return ""
        try:
            raw = self.cipher.decrypt(token.encode())
            return raw.decode()
        except Exception:
            return "ERR:INVALID_TOKEN"
